# Database Configuration (Development Only)
POSTGRES_USER=booksy_user
POSTGRES_PASSWORD=booksy_password
POSTGRES_DB=booksy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://booksy_user:booksy_password@localhost:5432/booksy

# Database Connection Pool Configuration (optional)
# DB_POOL_SIZE: Number of connections to keep in the pool (default: 10)
# DB_MAX_OVERFLOW: Additional connections created when pool is exhausted (default: 10)
# DB_POOL_RECYCLE: Seconds before recycling connections to prevent stale connections (default: 3600)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# SQL Echo (set to true to enable SQL query logging for local diagnostics only -
# it logs bound parameter values, which may include customer PII)
SQL_ECHO=false

# ElevenLabs Configuration
ELEVENLABS_API_KEY=
# Must be a public HTTPS URL that ElevenLabs' hosted agent can reach over the
# internet (e.g. a tunnel to your local server, or a deployed instance) --
# localhost will not work since ElevenLabs calls this URL from their servers.
API_BASE_URL=https://your-public-domain.example.com
