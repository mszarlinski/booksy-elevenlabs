# Database Configuration (Development Only)
POSTGRES_USER=booksy_user
POSTGRES_PASSWORD=booksy_password
POSTGRES_DB=booksy

# ElevenLabs Configuration
ELEVENLABS_API_KEY=
# Must be a public HTTPS URL that ElevenLabs' hosted agent can reach over the
# internet (e.g. a tunnel to your local server, or a deployed instance) --
# localhost will not work since ElevenLabs calls this URL from their servers.
API_BASE_URL=https://your-public-domain.example.com
